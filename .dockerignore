# Never ship deps, build output, local state, or secrets into build contexts.
node_modules
**/node_modules
.next
**/.next
dist
build
out
**/*.tsbuildinfo

# Secrets and local env
.env
.env.*
!.env.example
!.env.production.example

# VCS and tooling
.git
.github
.agents
.claude
.playwright-mcp
.code-review-graph
graphify-out
coverage
**/coverage

# Docs and misc not needed at build/runtime
docs
reference
*.log

# Mirrored public copy (regenerated by sync-public.mjs at build time)
apps/web/public
