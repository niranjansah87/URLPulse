{
  "name": "urlpulse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @urlpulse/web dev",
    "dev:api": "pnpm --filter @urlpulse/api dev",
    "dev:worker": "pnpm --filter @urlpulse/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/with-env.mjs pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @urlpulse/api migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.3",
      "postcss": ">=8.5.23"
    }
  }
}
