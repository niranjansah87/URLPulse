# URLPulse environment configuration
# Copy to .env and adjust. NEVER commit a real .env or real credentials.

# --- Runtime ---
NODE_ENV=development

# --- PostgreSQL (source of truth) ---
# Matches the docker-compose local development credentials.
DATABASE_URL=postgresql://urlpulse:urlpulse@localhost:5432/urlpulse

# --- Redis (BullMQ, rate limiting, pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- PostgreSQL pooling ---
# Shared budget: (API instances + worker processes) x DB_POOL_MAX must stay
# under PostgreSQL max_connections (default 100).
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_STATEMENT_TIMEOUT_MS=30000

# --- API ---
API_PORT=4000

# --- System guarantees (see docs/03-backend) ---
RATE_LIMIT_RPS=10
MAX_CONCURRENCY=5
MAX_RETRIES=3

# --- Batch-list cache ---
BATCH_LIST_CACHE_SECONDS=30

# --- Web (browser-exposed; never put secrets in NEXT_PUBLIC_* variables) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
