# URLPulse environment configuration
# Copy to .env and adjust. NEVER commit a real .env or real credentials.

# --- Runtime ---
NODE_ENV=development

# --- PostgreSQL (source of truth) ---
# Matches the docker-compose local development credentials.
DATABASE_URL=postgresql://urlpulse:urlpulse@localhost:5432/urlpulse

# --- Redis (BullMQ, rate limiting, pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- PostgreSQL pooling ---
# Shared budget: (API instances + worker processes) x DB_POOL_MAX must stay
# under PostgreSQL max_connections (default 100).
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_STATEMENT_TIMEOUT_MS=30000

# --- Outbound URL health-check bounds (worker) ---
HTTP_TIMEOUT_MS=10000
HTTP_MAX_REDIRECTS=5
HTTP_MAX_BODY_BYTES=262144

# Distributed concurrency lease TTL; must exceed HTTP_TIMEOUT_MS plus margin.
CONCURRENCY_LEASE_TTL_MS=30000

# A URL PROCESSING longer than this is reclaimed to PENDING (crash recovery).
STUCK_PROCESSING_MS=60000

# How often the API runs the reconciliation sweep.
RECONCILE_INTERVAL_MS=30000

# SSRF: allow loopback/private targets. Local dev only; MUST be false in prod.
HTTP_ALLOW_PRIVATE_HOSTS=false

# --- API ---
API_PORT=4000

# --- Authentication (Better Auth, mounted on the API) ---
# Signs session cookies. MUST be a fixed, high-entropy value shared by every API
# instance so sessions survive restarts and work across instances. REQUIRED in
# production (startup fails without it); in development/test a built-in insecure
# default is used. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the API (where Better Auth is mounted).
BETTER_AUTH_URL=http://localhost:4000
# The web app origin, trusted for credentialed cross-origin auth requests.
# Also used to build the password-reset link: WEB_ORIGIN/reset-password?token=...
WEB_ORIGIN=http://localhost:3000

# --- Email (Resend, for password-reset delivery) ---
# REQUIRED in production so reset emails can be sent (startup fails without it).
# When unset in development/test the email service no-ops (never logs the token),
# so local runs and the test suite work without a provider.
RESEND_API_KEY=
# Verified sender. Must be a Resend-verified domain/address in production.
RESEND_FROM_EMAIL=URLPulse <onboarding@resend.dev>

# --- System guarantees (see docs/03-backend) ---
RATE_LIMIT_RPS=10
MAX_CONCURRENCY=5
MAX_RETRIES=3

# --- Batch-list cache ---
BATCH_LIST_CACHE_SECONDS=30

# --- Web (browser-exposed; never put secrets in NEXT_PUBLIC_* variables) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Web server-side API base (Server Components) ---
# Internal/loopback address the Next.js server uses to reach the API. Keep IPv4
# loopback locally (Node may resolve localhost to ::1 while the API binds IPv4).
API_INTERNAL_URL=http://127.0.0.1:4000/api
