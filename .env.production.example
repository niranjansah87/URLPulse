# URLPulse production environment - PLACEHOLDERS ONLY.
# Copy to .env.production and fill in real values. NEVER commit .env.production.
#   ./scripts/deploy.sh   (or: docker compose --env-file .env.production -f docker-compose.prod.yml up -d)

# --- Runtime ---
NODE_ENV=production

# --- Deploy: Let's Encrypt contact email (used by scripts/deploy.sh -> certbot) ---
# Only read by the deploy script when issuing the TLS certificate; the app ignores
# it. Can also be passed as --email ADDR. Leave blank to be prompted.
CERTBOT_EMAIL=

# --- External PostgreSQL (source of truth) ---
# Managed outside Docker. Add ?sslmode=require if your provider mandates TLS.
DATABASE_URL=postgresql://USER:PASSWORD@db-host.example.com:5432/urlpulse

# --- External Redis (BullMQ, rate limiter, pub/sub) ---
# Use rediss:// (not redis://) if the provider requires TLS.
REDIS_URL=rediss://:PASSWORD@redis-host.example.com:6380

# --- API ---
API_PORT=4000
# The API runs behind nginx, which sets X-Forwarded-For -> trust it for the
# real client IP (per-IP demo rate limit). Only true behind a trusted proxy.
TRUST_PROXY=true
# Production MUST block loopback/private/metadata targets (SSRF).
HTTP_ALLOW_PRIVATE_HOSTS=false

# --- Authentication (Better Auth, mounted on the API) ---
# High-entropy, fixed across all API replicas. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32
# Public base URL of the API (same origin as the site; nginx routes /api).
BETTER_AUTH_URL=https://urlpulse.niranjansah87.com.np
# The single trusted browser origin (CORS + CSRF + Better Auth). Same domain,
# because nginx serves web and API from one origin.
WEB_ORIGIN=https://urlpulse.niranjansah87.com.np

# --- Email (Resend, password-reset / verification delivery) ---
# REQUIRED in production; the API refuses to start without it.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=URLPulse <no-reply@niranjansah87.com.np>

# --- Web: browser-exposed (BUILD-TIME; inlined into the bundle) ---
# NEVER put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=https://urlpulse.niranjansah87.com.np/api
NEXT_PUBLIC_SITE_URL=https://urlpulse.niranjansah87.com.np

# --- Web: server-side API base (RUNTIME; Server Components -> API) ---
# Internal Docker hostname; never reachable from the browser (that's fine).
API_INTERNAL_URL=http://api:4000/api

# --- System guarantees (defaults are correct; override only deliberately) ---
RATE_LIMIT_RPS=10
MAX_CONCURRENCY=5
MAX_RETRIES=3
BATCH_LIST_CACHE_SECONDS=30

# --- PostgreSQL pooling ---
# (API replicas + worker processes) x DB_POOL_MAX must stay under the server's
# max_connections. Better Auth adds a small fixed pool (5) per API instance.
DB_POOL_MAX=10
